Meta.DisplayName=Battlefield: Bad Company 2 (Project Rome)
Meta.Description=Personal-use wrapper template for the russianvivi/bc2rome Docker image. Requires Docker CLI and host Docker socket access from the AMP instance environment.
Meta.OS=Linux
Meta.Arch=All
Meta.Author=Custom
Meta.URL=https://github.com/russianvivi/bc2rome
Meta.ConfigManifest=bc2romeconfig.json
Meta.MetaConfigManifest=bc2romemetaconfig.json
Meta.ConfigRoot=bc2rome.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=Personal-use draft. Requires Docker CLI and /var/run/docker.sock in the environment where this Generic instance runs; not verified on AMP-in-Docker.
Meta.ConfigReleaseState=PreRelease
Meta.DisplayImageSource=steam:24960
Meta.ConfigVersion=2
Meta.AppConfigId=bc2rome-local-template-20261028
Meta.ImportableExtensions=[]
App.DisplayName=Battlefield: Bad Company 2 (Project Rome)
App.RootDir=./bc2rome/
App.BaseDirectory=./bc2rome/
App.ExecutableWin=
App.ExecutableLinux=docker
App.WorkingDir=
App.LinuxCommandLineArgs=run --rm --name {{$ContainerName}} --network br0 --ip {{$ServerIP}} -v {{$InstancePath}}:/project/R34_Full/Instance {{$Image}}
App.WindowsCommandLineArgs=
App.CommandLineArgs={{$PlatformArgs}} {{$FormattedArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.ExitMethod=CtrlC
App.ExitTimeout=30
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[bc2romeports.json]
App.PrimaryApplicationPortRef=GameUdpPort1
App.AdminPortRef=ProconPort
App.UseRandomAdminPassword=False
App.AdminMethod=STDIO
App.UpdateSources=[]
App.RapidStartup=False
App.SmartExcludeSupported=False
App.ApplicationReadyMode=RegexMatch
Console.AppReadyRegex=^.*(server|Server|ready|Ready|running|Running).*
Console.UserJoinRegex=
Console.UserLeaveRegex=
Console.UserChatRegex=
Console.UpdateAvailableRegex=
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Limits.SleepMode=False
